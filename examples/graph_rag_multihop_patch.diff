+        // ════════════════════════════════════════════════════════════════════
+        // MULTI-HOP REASONING IMPLEMENTATION
+        // ════════════════════════════════════════════════════════════════════
+
+        class GraphOperations {
+            constructor(graphData, insightsData) {
+                this.data = graphData;
+                this.insights = insightsData || [];
+                this.nodeMap = new Map();
+                this.data.nodes.forEach(n => this.nodeMap.set(n.gid, n));
+            }
+
+            search(keywords, maxResults = 10) {
+                const kws = keywords.toLowerCase().split(/\s+/).filter(w => w.length > 2);
+                const scores = new Map();
+
+                this.data.nodes.forEach(n => {
+                    const label = (n.label || '').toLowerCase();
+                    let score = 0;
+                    kws.forEach(kw => {
+                        if (label === kw) score += 5;
+                        else if (label.includes(kw)) score += 2;
+                    });
+                    if (score > 0) scores.set(n.gid, score);
+                });
+
+                return Array.from(scores.entries())
+                    .sort((a, b) => b[1] - a[1])
+                    .slice(0, maxResults)
+                    .map(([gid, score]) => ({
+                        gid, label: this.nodeMap.get(gid).label, score
+                    }));
+            }
+
+            expand(nodeId, maxNeighbors = 10) {
+                const node = this.nodeMap.get(nodeId);
+                if (!node) return { error: 'Node not found' };
+
+                const neighbors = [];
+                this.data.links.forEach(link => {
+                    const srcId = typeof link.source === 'object' ? link.source.gid : link.source;
+                    const tgtId = typeof link.target === 'object' ? link.target.gid : link.target;
+
+                    if (srcId === nodeId) {
+                        neighbors.push({
+                            direction: 'outgoing',
+                            relation: link.relation || 'related',
+                            neighbor: this.nodeMap.get(tgtId)?.label,
+                            neighbor_id: tgtId
+                        });
+                    }
+                    if (tgtId === nodeId) {
+                        neighbors.push({
+                            direction: 'incoming',
+                            relation: link.relation || 'related',
+                            neighbor: this.nodeMap.get(srcId)?.label,
+                            neighbor_id: srcId
+                        });
+                    }
+                });
+
+                return { node: node.label, neighbors: neighbors.slice(0, maxNeighbors) };
+            }
+
+            findPath(startId, endId, maxDepth = 5) {
+                if (!this.nodeMap.has(startId) || !this.nodeMap.has(endId)) {
+                    return { error: 'Node not found' };
+                }
+
+                const queue = [[startId]];
+                const visited = new Set([startId]);
+
+                while (queue.length > 0) {
+                    const path = queue.shift();
+                    const current = path[path.length - 1];
+
+                    if (current === endId) {
+                        return {
+                            found: true,
+                            path: path.map(id => this.nodeMap.get(id).label),
+                            path_ids: path
+                        };
+                    }
+
+                    if (path.length >= maxDepth) continue;
+
+                    const neighbors = this.getNeighborIds(current);
+                    for (const n of neighbors) {
+                        if (!visited.has(n)) {
+                            visited.add(n);
+                            queue.push([...path, n]);
+                        }
+                    }
+                }
+
+                return { found: false };
+            }
+
+            getNeighborIds(nodeId) {
+                const neighbors = new Set();
+                this.data.links.forEach(link => {
+                    const srcId = typeof link.source === 'object' ? link.source.gid : link.source;
+                    const tgtId = typeof link.target === 'object' ? link.target.gid : link.target;
+                    if (srcId === nodeId) neighbors.add(tgtId);
+                    if (tgtId === nodeId) neighbors.add(srcId);
+                });
+                return Array.from(neighbors);
+            }
+        }
+
+        class GraphReActAgent {
+            constructor(graphOps, llmCaller, options = {}) {
+                this.ops = graphOps;
+                this.callLLM = llmCaller;
+                this.maxSteps = options.maxSteps || 6;
+                this.trace = [];
+            }
+
+            async query(question) {
+                this.trace = [];
+                const systemPrompt = `You are a graph reasoning agent. Available actions:
+SEARCH(keywords) - Find nodes
+EXPAND(node_id) - Get neighbors
+PATH(node1_id, node2_id) - Find path
+ANSWER(text) - Final answer
+
+Format: THOUGHT: [reasoning] ACTION: [NAME]([params])
+When ready to answer, use: THOUGHT: I can now answer ACTION: ANSWER(your answer)`;
+
+                let context = '';
+                let finalAnswer = null;
+
+                for (let step = 0; step < this.maxSteps; step++) {
+                    const msgs = [
+                        { role: 'system', content: systemPrompt },
+                        { role: 'user', content: `Previous context:\n${context}\n\nQuestion: ${question}` }
+                    ];
+
+                    const response = await this.callLLM(msgs);
+                    const action = this.parseAction(response);
+
+                    this.trace.push({ step: step + 1, ...action });
+
+                    if (action.action === 'ANSWER') {
+                        finalAnswer = action.params;
+                        this.trace[this.trace.length - 1].observation = 'Final answer';
+                        break;
+                    }
+
+                    const obs = await this.executeAction(action);
+                    this.trace[this.trace.length - 1].observation = obs;
+                    context += `\nStep ${step + 1}: ${action.action}(${action.params}) → ${JSON.stringify(obs)}\n`;
+                }
+
+                return { answer: finalAnswer || 'No answer found', trace: this.trace, steps: this.trace.length };
+            }
+
+            parseAction(response) {
+                const thoughtMatch = response.match(/THOUGHT:\s*(.+?)(?=ACTION:|$)/is);
+                const actionMatch = response.match(/ACTION:\s*(\w+)\s*\(([^)]*)\)/i);
+
+                if (!actionMatch) {
+                    return { thought: 'Completing', action: 'ANSWER', params: response };
+                }
+
+                return {
+                    thought: thoughtMatch ? thoughtMatch[1].trim() : '',
+                    action: actionMatch[1].toUpperCase(),
+                    params: actionMatch[2].trim()
+                };
+            }
+
+            async executeAction(action) {
+                switch (action.action) {
+                    case 'SEARCH': return this.ops.search(action.params);
+                    case 'EXPAND': return this.ops.expand(action.params);
+                    case 'PATH':
+                        const [start, end] = action.params.split(',').map(s => s.trim());
+                        return this.ops.findPath(start, end);
+                    default: return { error: 'Unknown action' };
+                }
+            }
+
+            getTraceHTML() {
+                return this.trace.map((s, i) => `
+                    <div class="trace-step">
+                        <div class="trace-header">Step ${i + 1}</div>
+                        <div><span class="trace-label">💭 Thought:</span> ${s.thought}</div>
+                        <div><span class="trace-label">⚡ Action:</span> ${s.action}(${s.params})</div>
+                        <div><span class="trace-label">👁️ Observation:</span> <pre>${JSON.stringify(s.observation, null, 2)}</pre></div>
+                    </div>
+                `).join('');
+            }
+        }
+
